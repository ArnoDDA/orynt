# Optional local configuration. Copy to .env; never commit real credentials.
PORT=4173
# ORYNT_DATA_DIR=/absolute/path/to/workspace-data

# Paid media generation; leave empty to keep the provider disconnected.
YOUMIND_API_KEY=

# Optional model-assisted text strategy (local planning is the default).
ORYNT_STRATEGY_MODEL=local
CLAUDE_API_KEY=
CLAUDE_API_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Optional absolute executable/font paths.
# ORYNT_VIDEO_PYTHON=/absolute/path/to/Orynt/.local/video-python/bin/python
# ORYNT_TEMPLATE_PYTHON=/absolute/path/to/python
# ORYNT_FFMPEG=/absolute/path/to/ffmpeg
# ORYNT_FFPROBE=/absolute/path/to/ffprobe
# ORYNT_FONT=/absolute/path/to/font.ttf
